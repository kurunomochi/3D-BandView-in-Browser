[Unit]
Description=Kurumochi blog and Blender portfolio
After=network.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/blog
EnvironmentFile=/opt/blog/.env
Environment=BLOG_BIND=127.0.0.1:3001
Environment=BLOG_DATA_DIR=/opt/blog/data
Environment=BLOG_PUBLIC_DIR=/opt/blog/public
ExecStart=/opt/blog/target/release/blog
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/blog/data

[Install]
WantedBy=multi-user.target
